{
	"name": "diem-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply diem --local",
		"db:migrate:remote": "wrangler d1 migrations apply diem --remote",
		"deploy": "npm run build && wrangler deploy",
		"test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260830.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.46.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^26.4.0",
		"drizzle-kit": "^0.31.5",
		"svelte": "^5.42.2",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.9",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"drizzle-orm": "^0.44.6"
	}
}
